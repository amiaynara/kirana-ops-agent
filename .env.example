ENV=local
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
DB_PATH=./data/local.db
LOG_LEVEL=INFO
# Comma-separated allowlist of Telegram chat IDs allowed to talk to the bot,
# e.g. "111111111,222222222". Required for a real deployment -- without it,
# any stranger who finds the bot's username gets full read/write access to
# the shop's inventory, khata ledger, and preferences. Safe to leave empty
# for local/dev only.
ALLOWED_TELEGRAM_CHAT_IDS=
